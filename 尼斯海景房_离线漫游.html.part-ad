        dpX.xz * interiorScale, dpY.xz * interiorScale).rgb;
    if (w.z > 0.0) sampleValue += w.z * textureGrad(interiorSurface, p.xy * interiorScale,
        dpX.xy * interiorScale, dpY.xy * interiorScale).rgb;
    return sampleValue;
